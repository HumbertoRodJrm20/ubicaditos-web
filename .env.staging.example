# ==========================================================
# Ubicaditos — Entorno de STAGING (rama staging)
# Copiar como .env y ajustar los valores reales.
# PostgreSQL es EL único motor permitido en staging.
# ==========================================================

APP_NAME=Ubicaditos
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.ubicaditos.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------
# Base de datos: PostgreSQL en Railway
# En el servicio web configura DB_URL como referencia a Postgres.DATABASE_URL.
# No copiar credenciales reales a este archivo ni al repositorio.
# DB_URL/DATABASE_URL prevalecen sobre DB_HOST/DB_PORT/DB_DATABASE.
# ----------------------------------------------------------
DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://usuario:password@host:5432/base
DB_SSLMODE=require
DB_SCHEMA=public
DB_CHARSET=utf8

# Valores locales de referencia; DB_URL/DATABASE_URL los reemplazan en Railway.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ubicaditos_staging
DB_USERNAME=ubicaditos_staging
DB_PASSWORD=

# Las cuentas de staging usan correos ficticios creados en base de datos.
EMAIL_VERIFICATION_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Railway Free de inicio: sin servicio Reverb ni worker; el cliente usa polling.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Para habilitar WebSockets, agrega Reverb como servicio Railway adicional,
# configura las variables REVERB_* y compila VITE_REVERB_* en tiempo de build.

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@ubicaditos.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"