# ==========================================================
# Ubicaditos — Entorno de PRODUCCIÓN (rama main)
# Copiar como .env y ajustar los valores reales.
# PostgreSQL es EL único motor permitido en producción.
# ==========================================================

APP_NAME=Ubicaditos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ubicaditos.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----------------------------------------------------------
# Base de datos: PostgreSQL
# ----------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ubicaditos
DB_USERNAME=ubicaditos
DB_PASSWORD=secret
DB_CHARSET=utf8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ----------------------------------------------------------
# Tiempo real (WebSockets con Laravel Reverb)
# ----------------------------------------------------------
# Credenciales generadas con: php artisan reverb:generate
# El servidor WebSocket debe correr como servicio:
#   php artisan reverb:start --host=0.0.0.0 --port=8080
# Si no está disponible, el navegador usa polling de /api/buses/active.
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=ubicaditos.example.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------------
# Correo (SMTP en producción)
# ----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ubicaditos.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"